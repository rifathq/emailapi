# Port the Express server listens on
PORT=5000

# Gmail (or other SMTP) credentials used to SEND the mail
# If using Gmail, EMAIL_PASS must be a 16-character "App Password",
# not your normal Gmail login password.
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your-sending-address@gmail.com
EMAIL_PASS=your-16-char-app-password

# Address that receives the contact form submissions
RECEIVER_EMAIL=mepromoter22@gmail.com

# Comma-separated list of origins allowed to call this API
CLIENT_ORIGIN=http://localhost:5173
